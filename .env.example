PORT=5000
# MongoDB connection string. Local: mongodb://127.0.0.1:27017/soil_fertility
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/soil_fertility?retryWrites=true&w=majority
MONGO_URI=
# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Frontend ORIGIN allowed by CORS (no path, no trailing slash). Comma-separate several.
# GitHub Pages: https://USERNAME.github.io     (NOT https://USERNAME.github.io/REPO)
FRONTEND_URL=
# Set to "production" on the hosting service
NODE_ENV=development
# Optional: passwords used by `npm run seed` (defaults are demo-only)
SEED_ADMIN_PASSWORD=
SEED_FARMER_PASSWORD=
